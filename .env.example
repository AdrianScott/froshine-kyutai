# Froshine Configuration

# Audio device settings
#FROSHINE_AUDIO_DEVICE=USB  # Use USB device name or index
#FROSHINE_LIST_DEVICES=1    # List available audio devices

# Kyutai streaming settings
#FROSHINE_KYUTAI_WS_URL=ws://127.0.0.1:8908/api/asr-streaming
#FROSHINE_KYUTAI_API_KEY=public_token
#FROSHINE_KYUTAI_VAD_HEAD=2
#FROSHINE_KYUTAI_VAD_THRESHOLD=0.5
#FROSHINE_KYUTAI_CONFIG=configs/config1-stt-en-hf.toml
# Note: if log_dir in the config uses $HOME or ~, auto-start expands it into a .expanded.toml copy.
#FROSHINE_FORCE_BATCH_SIZE=16
#FROSHINE_KYUTAI_AUTO_CONFIG=1
#FROSHINE_MIN_FREE_VRAM_EN_MB=12000
#FROSHINE_AUTO_SERVER=1
#FROSHINE_AUTO_SERVER_STOP=1
#FROSHINE_MOSHI_SERVER_ARGS=--addr 127.0.0.1 --port 8908
#FROSHINE_MOSHI_LOG_LEVEL=warn
#FROSHINE_MOSHI_READY_TIMEOUT=30
#FROSHINE_MOSHI_READY_INTERVAL=0.5

# Command word behavior
#FROSHINE_COMMAND_WORD=flow
#FROSHINE_COMMAND_WORD_ALIASES=flow,flo,glow,flowe
#FROSHINE_REQUIRE_WAKE_WORD=1
